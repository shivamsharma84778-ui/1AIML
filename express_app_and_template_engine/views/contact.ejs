<!DOCTYPE html>
<html>
<body>
  <h2>Contact Us</h2>
  <form action="/contact" method="POST">
    <input type="text" name="name" placeholder="Your Name" required><br><br>
    <input type="text" name="msg" placeholder="Message" required><br><br>
    <button type="submit">Send</button>
  </form>
  <p><%= message %></p>
  <a href="/">Back Home</a>
</body>
</html>